<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 (API <= 30) counterpart of data_extraction_rules.xml.
  allowBackup="false" already blocks Auto Backup and `adb backup` on these
  releases; these excludes state the same intent for any OEM backup agent
  that honours the rules file instead. `exclude` requires a path, so "."
  selects the whole domain.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
