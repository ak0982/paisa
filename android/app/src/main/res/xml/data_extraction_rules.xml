<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup / transfer rules.

  Paisa's promise is that parsed bank alerts never leave the device. The
  SQLite DB (paisa_transactions.db) and shared_prefs hold the full financial
  history in plaintext, so every domain is excluded from both paths:

    * cloud-backup   — Google Auto Backup / Drive (allowBackup="false" already
                       covers this, kept explicit so the intent survives).
    * device-transfer — NOT disabled by allowBackup="false" on Android 12+;
                       without these excludes the whole DB would be copied to
                       a new phone during device-to-device setup.

  Only the five base domains are listed: the app stores nothing in
  device-protected storage, and lint rejects the device_* variants. Excluding
  "root" covers the data directory the DB and prefs actually live in.
  Cross-platform (iOS) transfer is deliberately absent — omitting the element
  is what opts out. `exclude` requires a path, so "." selects the whole domain.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
